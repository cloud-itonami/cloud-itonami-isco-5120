;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a prep-support robot performs ingredient
;; portioning, temperature monitoring and cleanup tasks for a cook.
;; Declared here: the cooling of a cooked batch the robot monitors (the
;; food-safety cooling window), and the loaded hotel pan the robot lifts
;; from the pass into the blast chiller.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-5120"
 :cases
 [{:id :cooked-batch-cooling
   :kind :thermal
   :procedure "a pan of cooked food at 57 C cools in the blast chiller; the pan bottom (worst case, treated as insulated) must be at or below 21 C after 2 hours"
   :params {:conductivity-w-mk 0.50 :density-kg-m3 1050.0 :specific-heat-j-kgk 3600.0
            :t0-c 57.0 :t-hot-c 3.0 :h-front-w-m2k 25.0
            :t-back-ambient-c 3.0 :h-back-w-m2k 0.0
            :threshold-c 200.0 :duration-s 7200.0 :nodes 21}
   :sweep {:param :thickness-m :values [0.02 0.04 0.05 0.065 0.08 0.10]}
   :quantity :final-back-c
   :limit {:max 21.0 :basis "FDA Food Code 2017 3-501.14(A)(1): cooked TCS food cooled from 57 C (135 F) to 21 C (70 F) within 2 hours; food properties, 3 C chiller air and h = 25 W/m2K are estimates"}
   :boundary {:lo 0.01 :hi 0.15}}
  {:id :hotel-pan-to-chiller
   :kind :manipulator
   :procedure "arm lifts a loaded hotel pan from the pass onto a blast-chiller rack"
   :params {:l1-m 0.55 :l2-m 0.50 :m1-kg 6.0 :m2-kg 4.0
            :from [0.60 0.15] :to [0.70 0.40] :duration-s 2.0 :steps 500}
   :sweep {:param :payload-kg :values [2.0 5.0 8.0 12.0 16.0]}
   :quantity :peak-tau1-nm
   :limit {:max 180.0 :basis "estimate: continuous shoulder torque of a ~15 kg-payload collaborative arm"}
   :boundary {:lo 0.5 :hi 40.0}}]}
